# Copy to .env and fill in your values.
# The agent loads this file automatically at startup.

# LLM Provider selection
LLM_PROVIDER=claude          # claude | openai | google | ollama | openrouter
LLM_MODEL=                   # leave blank to use the provider default

# API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
